# ============================================================
# CodeTutor AI - environment configuration (EXAMPLE ONLY)
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file or real API keys.
# ============================================================

# ------------------------------------------------------------
# AI Provider (any OpenAI-compatible chat completions API)
# ------------------------------------------------------------
# Example: NVIDIA NIM (https://build.nvidia.com) - create a key there,
# then use the "list models" page to pick a model id, e.g.:
#   meta/llama-3.3-70b-instruct
#   nvidia/llama-3.1-nemotron-70b-instruct
# Other examples:
#   OpenAI:     https://api.openai.com/v1        model: gpt-4o-mini
#   Groq:       https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1     model: openai/gpt-4o-mini
#   Ollama:     http://127.0.0.1:11434/v1       model: llama3.1

# The API key is ONLY read by the backend. Leave it empty here.
CODETUTOR_API_KEY=

CODETUTOR_API_BASE_URL=https://integrate.api.nvidia.com/v1
CODETUTOR_PROVIDER_NAME=NVIDIA NIM
CODETUTOR_MODEL=meta/llama-3.3-70b-instruct

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
CODETUTOR_HOST=127.0.0.1
CODETUTOR_PORT=8000
# Optional: store app data somewhere other than <repo>/data
# CODETUTOR_DATA_DIR=

# NOTE: You can also configure the provider at runtime in the app's
# Settings page. The Settings page stores the key in a local
# secrets file (data/secrets.json) that is never exposed to the
# browser. Environment variables are used as a fallback default.
